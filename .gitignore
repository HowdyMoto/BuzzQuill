# =============================================================================
# Secrets and local configuration — FIRST, because this is the costly one.
#
# The rule that was missing: `*.local` covered `.env.local`, but a bare `.env`
# was committable. Anything env-shaped is now ignored by default and the sample
# is re-included explicitly, so the safe file is the one you have to opt in.
# =============================================================================
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Credentials, keys and certificates. The app has no server-side secrets today;
# anything matching the patterns below must never be committed regardless.
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.keystore
*.jks
secrets.json
credentials.json
service-account*.json
gha-creds-*.json
.npmrc
.yarnrc
.netrc

# =============================================================================
# Dependencies and build output
# =============================================================================
node_modules
dist
dist-ssr
build
out
*.local

# =============================================================================
# Tooling caches — regenerated, machine-specific, and noisy in diffs
# =============================================================================
.vite/
.cache/
.parcel-cache/
.turbo/
.rollup.cache/
.eslintcache
.stylelintcache
.prettiercache
*.tsbuildinfo
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# =============================================================================
# Logs and crash dumps
# =============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# =============================================================================
# Tests and coverage
# =============================================================================
coverage/
*.lcov
.nyc_output/
.vitest/
/test-results/
/playwright-report/
/blob-report/
/.playwright/
# Playwright MCP browser-QA artifacts (snapshots/console logs from agent sessions)
/.playwright-mcp/

# Large real-world SVG test corpus (~313MB): downloaded on demand via
# `npm run corpus:fetch` (see test/corpus/corpus.json). The manifest + fetch
# script are committed; the heavy .svg files are not.
/test/corpus/svg/

# Broad SVG smoke tier (W3C SVG 1.1 suite): fetched via `npm run smoke:fetch`.
/test/smoke/svg/
/test/smoke/.cache/

# =============================================================================
# Deploy / hosting scratch. The site ships via Cloudflare Pages — note that
# public/_headers IS tracked (it's the real CSP header source) and must not be
# caught by anything here.
# =============================================================================
.wrangler/
.vercel/
.netlify/
.firebase/
.serverless/
.amplify/

# =============================================================================
# Editors and IDEs
# =============================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea
.fleet/
.zed/
.history/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Agent/assistant working directories
.claude/
.aider*
.cursor/

# =============================================================================
# OS cruft
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# =============================================================================
# Scratch, backups and merge leftovers — easy to create by accident, never
# meant to be shared.
# =============================================================================
tmp/
temp/
scratch/
*.bak
*.orig
*.rej
*.tmp
*~

# Local review screenshots and release staging
/*-after.png
release-staging/
/public/third-party-notices.txt
